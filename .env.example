# Discord Bot Token (required)
DISCORD_TOKEN=your_discord_token_here

# Client ID (required for slash commands - your bot's application ID)
CLIENT_ID=your_client_id_here

# Guild ID (optional - for guild-specific slash command deployment, faster updates)
GUILD_ID=your_guild_id_here

# Development Guild ID (optional - for one-time setup messages)
DEV_GUILD_ID=your_guild_id_here

# Logging level (optional - defaults to "info")
# Options: error, warn, info, debug
LOG_LEVEL=info

# Node environment (optional - defaults to "development")
# Options: development, production
NODE_ENV=development
